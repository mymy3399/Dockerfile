# Environment Configuration for Government Asset Management System
# Copy this file to .env and update the values according to your environment

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=4000
WEB_PORT=3000
API_PORT=4000

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# PostgreSQL Database Configuration
DATABASE_NAME=government_asset_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres123
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Full database connection URL
# For production, reference from Vault: vault:secret/data/database#url
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# ==============================================
# REDIS CONFIGURATION
# ==============================================
# Redis Cache/Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# For production, reference from Vault: vault:secret/data/redis#url
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ==============================================
# AUTHENTICATION & SECURITY
# ==============================================
# JWT Authentication Secret
# For production, reference from Vault: vault:secret/data/auth#secret
AUTH_SECRET=your-super-secret-jwt-key-change-in-production

# Session configuration
SESSION_SECRET=your-super-secret-session-key-change-in-production

# CORS allowed origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==============================================
# FEATURE FLAGS
# ==============================================
# Enable/disable RBAC (Role-Based Access Control)
RBAC_ENABLED=false

# Enable/disable audit logging
AUDIT_ENABLED=true

# Enable/disable OpenTelemetry tracing
TELEMETRY_ENABLED=false

# ==============================================
# EXTERNAL SERVICES
# ==============================================
# Next.js Public API URL (for client-side calls)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ==============================================
# OBSERVABILITY & MONITORING
# ==============================================
# Jaeger tracing endpoint (when TELEMETRY_ENABLED=true)
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Log level (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=info

# ==============================================
# VAULT INTEGRATION (On-premises Secret Management)
# ==============================================
# Example Vault configuration for on-premises deployment
# VAULT_ADDR=https://vault.your-domain.com
# VAULT_TOKEN=your-vault-token
# VAULT_NAMESPACE=government-assets

# Example Vault secret paths (reference these in production instead of plain values):
# Database: vault:secret/data/postgres#DATABASE_URL
# Auth Secret: vault:secret/data/auth#AUTH_SECRET
# Redis: vault:secret/data/redis#REDIS_URL
# External API Keys: vault:secret/data/external-apis#API_KEY

# ==============================================
# DOCKER COMPOSE OVERRIDES
# ==============================================
# Uncomment and modify for docker-compose customization
# COMPOSE_PROJECT_NAME=government-asset-management
# COMPOSE_FILE=infra/docker-compose.yml:infra/docker-compose.override.yml

# ==============================================
# ON-PREMISES DEPLOYMENT SETTINGS
# ==============================================
# Network configuration for on-premises deployment
# CLUSTER_IP_RANGE=10.0.0.0/8
# SERVICE_ACCOUNT_KEY_PATH=/etc/secrets/service-account.json

# ==============================================
# DEVELOPMENT SETTINGS
# ==============================================
# Enable debug mode for development
DEBUG=false

# Hot reload for development (docker-compose)
CHOKIDAR_USEPOLLING=true

# Prisma Studio port
PRISMA_STUDIO_PORT=5555

# ==============================================
# PRODUCTION NOTES
# ==============================================
# For production deployment:
# 1. Change all passwords and secrets
# 2. Use proper Vault/Key Vault references instead of plain text values
# 3. Set NODE_ENV=production
# 4. Enable RBAC_ENABLED=true
# 5. Configure proper ALLOWED_ORIGINS
# 6. Set up proper SSL/TLS certificates
# 7. Configure resource limits in Kubernetes manifests
# 8. Set up monitoring and alerting
# 9. Configure backup strategies for PostgreSQL
# 10. Review and update security policies